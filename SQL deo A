-- 1. Колико утакмица је одиграно у фебруару 2025?

SELECT COUNT(match_id) AS no_of_matches
FROM matches
WHERE kickoff_ts >= '2025-02' AND kickoff_ts < '2025-03';

-- U februaru 2025. odigrano je 40 utakmica



-- 2. Који стадион има највећи капацитет, а који је највећи стадион неког клуба?


SELECT stadium_name, capacity FROM stadiums ORDER BY capacity DESC LIMIT 1;

-- Najveći kapacitet ima nacionalni stadion (National Stadium) sa 80.000 mesta.


SELECT stadium_name, capacity
FROM stadiums
WHERE stadium_name NOT IN ('National Stadium') 
ORDER BY capacity DESC
LIMIT 1;
-- Najveći kapacitet nekog kluba ima stadion Harbourside Park sa 52.000 mesta.



