-- 1. Преглед сезоне: број утакмица и голова, просечан број голова по утакмици, удео победа
-- домаћина, нерешених и победа гостију

SELECT  COUNT(match_id) AS total_games, 
        SUM(home_goals + away_goals) AS total_goals,
        ROUND(total_goals / total_games, 2) AS avg_goals_per_match,
        ROUND(100 * SUM(CASE WHEN home_goals > away_goals THEN 1 ELSE 0 END) / total_games, 2) AS home_wins_percentage,
        ROUND(100 * SUM(CASE WHEN home_goals < away_goals THEN 1 ELSE 0 END) / total_games, 2) AS away_wins_percentage,
        ROUND(100 * SUM(CASE WHEN home_goals = away_goals THEN 1 ELSE 0 END) / total_games, 2) AS draws_percentage
FROM matches
WHERE season = '2024/25';

