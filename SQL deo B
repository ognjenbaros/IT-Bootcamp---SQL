-- 4. Судије: за сваког судију број утакмица и картони по утакмици.


SELECT  r.referee_name, r.nationality,
        COUNT(DISTINCT m.match_id) AS no_of_matches,
        SUM(CASE WHEN me.event_type IN ('yellow_card','second_yellow','red_card') THEN 1 ELSE 0 END) AS total_cards,
        ROUND(total_cards / no_of_matches, 2) AS cards_per_match
FROM referees AS r
JOIN matches AS m ON r.referee_id = m.referee_id AND m.season = '2024/25'
JOIN match_events AS me ON m.match_id = me.match_id
GROUP BY r.referee_name, r.nationality
ORDER BY cards_per_match DESC; 

