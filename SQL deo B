-- 3. Публика: просечна посета и попуњеност по стадиону; утакмице без податка о посети и
-- утакмица без публике.

SELECT * FROM matches;


SELECT  s.stadium_name,
        ROUND(AVG(m.attendance), 2) AS avg_att,
        s.capacity,
        CONCAT(ROUND(100 * avg_att / s.capacity, 2), '%') AS avg_fill
FROM matches AS m
LEFT JOIN stadiums AS s ON s.stadium_id = m.stadium_id
WHERE m.season = '2024/25'
GROUP BY s.stadium_name, s.capacity
ORDER BY avg_fill DESC;


SELECT COUNT(m.match_id)
FROM matches AS m
LEFT JOIN stadiums AS s ON m.stadium_id = s.stadium_id
WHERE m.season = '2024/25' AND m.attendance IS NULL;


SELECT COUNT_IF(m.attendance = 0)
FROM matches AS m
LEFT JOIN stadiums AS s ON m.stadium_id = s.stadium_id
WHERE m.season = '2024/25';


