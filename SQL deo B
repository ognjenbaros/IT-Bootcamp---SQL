-- 5. Играчи: пет најбољих стрелаца и пет најбољих асистената.

SELECT related_player_id FROM match_events WHERE event_type IN ('own_goal');
WITH top_scorers AS (
                    SELECT  me.player_id,
                            SUM(CASE WHEN event_type IN ('goal', 'penalty_goal', 'own_goal') THEN 1 ELSE 0 END) AS total_goals
                    FROM match_events AS me
                    JOIN matches AS m ON m.match_id = me.match_id AND m.season = '2024/25'
                    GROUP BY me.player_id
                    )
SELECT  p.player_id, CONCAT(p.first_name, ' ', p.last_name) AS player_name,
        ts.total_goals
FROM players AS p
JOIN top_scorers AS ts ON ts.player_id = p.player_id
ORDER BY ts.total_goals DESC
LIMIT 5;

 WITH top_assists AS (
                    SELECT  me.related_player_id,
                    SUM(CASE WHEN event_type IN ('goal', 'penalty_goal', 'own_goal') THEN 1 ELSE 0 END) AS total_assists
                    FROM match_events AS me
                    JOIN matches AS m ON m.match_id = me.match_id AND m.season = '2024/25'
                    GROUP BY me.related_player_id
                    )
SELECT  p.player_id, CONCAT(p.first_name, ' ', p.last_name) AS player_name,
        ta.total_assists
FROM players AS p
JOIN top_assists AS ta ON ta.related_player_id = p.player_id
ORDER BY ta.total_assists DESC
LIMIT 8;

