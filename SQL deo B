-- 2. По месецима: број утакмица и голова по месецима, и просечан број голова по утакмици у
-- сваком месецу. Који месец се издваја?


SELECT  MONTH(kickoff_ts) AS game_month,
        COUNT(match_id) AS total_games, 
        SUM(home_goals + away_goals) AS total_goals,
        ROUND(total_goals / total_games, 2) AS avg_goals_per_match
FROM matches
WHERE season = '2024/25'
GROUP BY game_month
ORDER BY game_month;


