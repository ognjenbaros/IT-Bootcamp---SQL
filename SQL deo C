-- 5. Пратите бодове клуба Northport City утакмицу по утакмицу у сезони 2024/25. У којој
-- утакмици по реду и ког датума је прешао 50 бодова?

SELECT team_id, team_name FROM teams WHERE team_name = 'Northport City'; --  team_id = 2

SELECT  match_id,
        ROW_NUMBER() OVER (ORDER BY kickoff_ts) AS game_in_season,
        DATE(kickoff_ts) AS match_date,
        SUM(points) OVER (ORDER BY kickoff_ts ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS points_so_far,
        result
FROM team_matches
WHERE team_id = 2 AND season = '2024/25'
QUALIFY points_so_far >= 50
ORDER BY kickoff_ts;

-- Ekipa Northport City u srpsku Novu godinu ušla je
-- sa više od 50 bodova, jer je 12. januara odnela pobedu
-- u 21. utakmici sezone 2024/25.