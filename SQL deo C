
-- 1. Колики удео у укупном броју голова лиге у сезони 2024/25 има сваки клуб? Ко има највећи
-- удео?

SELECT DISTINCT t.team_name,
        SUM(tm.goals_for) OVER (PARTITION BY tm.team_id) AS team_goals,
        (SELECT SUM(goals_for + goals_against) / 2 FROM team_matches WHERE season = '2024/25') AS total_goals,
        CONCAT(ROUND(100 * team_goals / total_goals, 2), '%') AS percentage
FROM team_matches AS tm
JOIN teams AS t ON t.team_id = tm.team_id
WHERE tm.season = '2024/25'
ORDER BY percentage DESC;

-- U sezoni 2024/25 najveći udeo u ukupnom broju golova
-- ima ekipa Kingsbridge City sa 7,6%



-- 2. Која су три стадиона са највећом просечном посетом у сезони 2024/25?

SELECT  m.season,
        s.stadium_name,
        ROUND(AVG(m.attendance), 2) AS avg_att,
        ROW_NUMBER() OVER (PARTITION BY m.season ORDER BY AVG(m.attendance) DESC) AS rn
FROM matches AS m
JOIN stadiums AS s ON m.stadium_id = s.stadium_id
WHERE m.season = '2024/25'
GROUP BY m.season, s.stadium_name
QUALIFY rn <= 3;

-- Tri stadiona sa najvećom prosečnom posetom u sezoni 2024/25
-- su Harbourside Park, Kingsbridge Stadium i Northport Arena.



-- 3. За сваки клуб, ко је дао последњи гол клуба у сезони 2024/25 и када? Који клуб је последњи
-- гол дао најраније?


WITH goal_order AS (
                SELECT team_id, player_id,
                ROW_NUMBER() OVER (PARTITION BY team_id 
                ORDER BY match_id DESC, (CASE WHEN added_time IS NULL THEN minute
                                        ELSE minute + added_time END) DESC) AS rn
                FROM match_events
                WHERE match_id >= 2000 AND match_id < 3000 AND event_type IN ('goal', 'own_goal', 'penalty_goal')
                   )
SELECT t.team_name, CONCAT(p.first_name, ' ', p.last_name) AS player_name
FROM goal_order AS go
JOIN teams AS t ON t.team_id = go.team_id
JOIN players AS p ON p.player_id = go.player_id
WHERE go.rn = 1;



WITH goal_order AS (
                SELECT team_id, match_id, player_id,
                ROW_NUMBER() OVER (PARTITION BY team_id 
                ORDER BY match_id DESC, (CASE WHEN added_time IS NULL THEN minute
                                        ELSE minute + added_time END) DESC) AS rn
                FROM match_events
                WHERE match_id >= 2000 AND match_id < 3000 AND event_type IN ('goal', 'own_goal', 'penalty_goal')
                QUALIFY rn = 1
                   )
SELECT m.kickoff_ts, t.team_name, CONCAT(p.first_name, ' ', p.last_name) AS player_name
FROM goal_order AS go
JOIN teams AS t ON t.team_id = go.team_id
JOIN players AS p ON p.player_id = go.player_id
JOIN matches AS m ON m.match_id = go.match_id
WHERE go.rn = 1
ORDER BY m.kickoff_ts ASC
LIMIT 1;

