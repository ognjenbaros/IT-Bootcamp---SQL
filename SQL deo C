-- 4. За домаће утакмице клуба Northport United у сезони 2024/25 прикажите посету и промену у
-- односу на претходну домаћу утакмицу. Где је највећи пад?


SELECT  t.team_name, m.home_team_id, m.away_team_id, m.kickoff_ts, m.weather,
        m.attendance,
        LAG(m.attendance) OVER (ORDER BY m.kickoff_ts) AS att_previous_match,
        m.attendance - coalesce(att_previous_match, 0) AS att_diff
FROM matches AS m
JOIN teams AS t ON t.team_id = m.home_team_id AND t.team_name = 'Northport United'
WHERE m.season = '2024/25'
ORDER BY att_diff;

